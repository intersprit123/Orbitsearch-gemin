# Generate a random secret of at least 32 characters before enabling key administration.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ORBIT_ADMIN_TOKEN=
# Optional comma-separated exact browser origins, e.g. https://app.example.com
ORBIT_ALLOWED_ORIGINS=
# Use a persistent private writable directory in production.
ORBIT_DATA_DIR=./data
PORT=3000
